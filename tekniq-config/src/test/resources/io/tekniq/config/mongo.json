{
  "mongo": {
    "uri": "mongodb://user:pass@host:27017",
    "database": "orders",
    "pool": { "min": 2, "max": 20, "acquireTimeoutMs": 45000 },
    "retry": { "attempts": 5, "backoffMs": 250 },
    "ssl": { "enabled": true, "trustStorePath": "/etc/ssl/mongo.jks" },
    "options": { "timeout": "5000", "appName": "order-service" },
    "tags": ["primary", "replica"]
  }
}
